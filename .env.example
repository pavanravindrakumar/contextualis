# Gemini API Key — server-side only, never expose to client
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "true" to force mock mode even if API key is set (for local testing)
USE_MOCK_GEMINI=false

# Allowed origin for CORS in production (defaults to * if unset)
# ALLOWED_ORIGIN=https://your-production-domain.vercel.app

# Node environment
NODE_ENV=development
